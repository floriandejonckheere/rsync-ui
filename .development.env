# ---------------------------------------------------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------------------------------------------------

# Rails environment
RAILS_ENV=development

# Log level: debug, info, warn, error, fatal
RAILS_LOG_LEVEL=debug

# Secret key
SECRET_KEY_BASE=secret_key_base

# Encryption credentials
#ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
#ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
#ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Skip credentials check on startup
# SKIP_CREDENTIALS_CHECK=0

# Skip configuration check on startup
# SKIP_CONFIGURATION_CHECK=0

# Skip SSH config sync on startup
# SKIP_SSH_CONFIG_SYNC=0

# Database credentials
PG_HOST=postgres
PG_USER=postgres
PG_PASSWORD=postgres

# Application details
APP_HOST=localhost
APP_EMAIL=app@localhost

# Administrator credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# AppSignal performance and error tracking
# APPSIGNAL_APP_NAME="Rsync UI"
# APPSIGNAL_PUSH_API_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------------------------------------------------

# Run Solid Queue worker inside the web container
SOLID_QUEUE_IN_PUMA=1

# Do not prompt when downloading tools
COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# Enable Mission Control dashboard
MISSION_CONTROL=1

# Skip initial repository seeding
SKIP_REPOSITORY_INIT=0

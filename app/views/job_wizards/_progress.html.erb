<%# locals: () %>
<div class="card mb-8">
  <nav class="flex items-center gap-2 px-6 py-4 text-sm flex-wrap">
    <% wizard_steps.each_with_index do |wizard_step, index| %>
      <% if current_step?(wizard_step) %>
        <span class="font-semibold text-gray-900 dark:text-gray-100">
          <%= I18n.t("job_wizards.steps.#{wizard_step}") %>
        </span>
      <% elsif index < wizard_steps.index(step) %>
        <%= link_to I18n.t("job_wizards.steps.#{wizard_step}"), wizard_path(wizard_step), class: "text-muted-foreground hover:text-gray-900 dark:hover:text-gray-100 hover:underline" %>
      <% else %>
        <span class="text-muted-foreground">
          <%= I18n.t("job_wizards.steps.#{wizard_step}") %>
        </span>
      <% end %>

      <% unless index == wizard_steps.length - 1 %>
        <%= lucide_icon "chevron-right", class: "h-4 w-4 text-muted-foreground" %>
      <% end %>
    <% end %>
  </nav>
</div>

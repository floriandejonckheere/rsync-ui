<%# locals: (f:) %>
<details class="card group py-0">
  <summary
    class="
      flex items-center justify-between w-full px-8 py-8 cursor-pointer
      list-none
    "
  >
    <h2 class="text-lg font-semibold">
      <%= I18n.t("jobs.form.advanced_options") %>
    </h2>

    <%= lucide_icon "chevron-down", class: "h-5 w-5 transition-transform duration-200 group-open:rotate-180" %>
  </summary>

  <div class="px-8 pb-8">
    <div class="flex flex-col gap-6">
      <div class="field flex-row items-center gap-4">
        <%= f.check_box :opt_superuser, role: "switch" %>
        <%= f.label :opt_superuser, I18n.t("jobs.form.opt_superuser.description") %>
      </div>

      <% %i[opt_acls opt_xattrs].each do |field| %>
        <div class="field">
          <div class="flex-row items-center gap-4 flex">
            <%= f.check_box field, role: "switch" %>
            <%= f.label field, I18n.t(:description, scope: [:jobs, :form, field]), data: { tooltip: I18n.t(:flag, scope: [:jobs, :form, field]) } %>
          </div>

          <% if macos_servers(f.object).any? %>
            <p class="text-sm text-muted-foreground flex items-center gap-2 mt-1">
              <%= lucide_icon "info", class: "h-4 w-4 shrink-0" %>
              <%= I18n.t(:macos_hint, scope: [:jobs, :form, field]) %>
            </p>
          <% end %>
        </div>
      <% end %>

      <% %i[opt_hard_links opt_devices opt_specials opt_checksum opt_compress opt_partial opt_backup opt_append opt_numeric_ids opt_itemize_changes opt_secluded_args opt_verbose].each do |field| %>
        <div class="field flex-row items-center gap-4">
          <%= f.check_box field, role: "switch" %>
          <%= f.label field, I18n.t(:description, scope: [:jobs, :form, field]), data: { tooltip: I18n.t(:flag, scope: [:jobs, :form, field]) } %>
        </div>
      <% end %>

      <% %i[opt_progress2 opt_no_inc_recursive].each do |field| %>
        <div class="field">
          <div class="flex-row items-center gap-4 flex">
            <%= f.check_box field, role: "switch" %>
            <%= f.label field, I18n.t(:description, scope: [:jobs, :form, field]), data: { tooltip: I18n.t(:flag, scope: [:jobs, :form, field]) } %>
          </div>

          <p class="text-sm text-muted-foreground flex items-center gap-2 mt-1">
            <%= lucide_icon "info", class: "h-4 w-4 shrink-0" %>
            <%= I18n.t(:mandatory_hint, scope: [:jobs, :form, field]) %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</details>

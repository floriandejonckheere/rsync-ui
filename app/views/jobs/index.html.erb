<% content_for :title do %>
  <%= I18n.t("jobs.index.title") %>
<% end %>

<% content_for :subtitle do %>
  <%= I18n.t("jobs.index.subtitle") %>
<% end %>

<% content_for :actions do %>
  <%= render "shared/search/search",
             url: jobs_path,
             query: @query,
             frame: "jobs_list",
             placeholder: I18n.t("jobs.index.search.placeholder") %>

  <%= link_to new_job_path, data: { tooltip: I18n.t("jobs.index.new") }, class: "btn-icon-outline btn-icon-lg" do %>
    <%= lucide_icon "plus", class: "h-6 w-6" %>
  <% end %>
<% end %>

<%= turbo_frame_tag "jobs_list" do %>
  <% if @jobs.empty? && @query.present? %>
    <%= render "shared/search/no_results", title: I18n.t("jobs.index.search.no_results.title") %>
  <% elsif @jobs.empty? %>
    <div
      class="
        card flex flex-col items-center justify-center py-16 gap-4
        text-gray-400
      "
    >
      <%= lucide_icon "arrow-right-left", class: "h-12 w-12" %>

      <p class="text-lg">
        <%= I18n.t("jobs.index.empty") %>
      </p>
    </div>
  <% else %>
    <% grouped_jobs = @jobs.group_by(&:category) %>
    <% uncategorized_jobs = grouped_jobs.delete(nil) %>

    <div class="flex flex-col gap-6">
      <% if uncategorized_jobs.present? %>
        <div>
          <% if grouped_jobs.any? %>
            <h2 class="mt-10 mb-6 text-2xl font-semibold dark:text-gray-100">
              <%= I18n.t("jobs.index.uncategorized") %>
            </h2>
          <% end %>

          <div class="card p-0">
            <%= render "table", jobs: uncategorized_jobs %>
          </div>
        </div>
      <% end %>

      <% grouped_jobs.each do |category, category_jobs| %>
        <div>
          <%= render "shared/category_heading", category: %>

          <div class="card p-0">
            <%= render "table", jobs: category_jobs %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <%= render "shared/pagination", pagy: @pagy, path_method: :jobs_path %>
    <% end %>
  <% end %>
<% end %>

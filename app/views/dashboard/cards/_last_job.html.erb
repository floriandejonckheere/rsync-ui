<div class="card flex flex-col gap-2">
  <h2
    class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"
    title="<%= last_job_run&.job&.name %>"
  >
    <% if last_job_run.nil? %>
      <%= I18n.t("dashboard.jobs.last_job") %>
    <% else %>
      <%= I18n.t("dashboard.jobs.last_job") %>
      :
      <%= last_job_run.job.name %>
    <% end %>
  </h2>

  <% if last_job_run.nil? %>
    <p class="text-xs text-gray-400 dark:text-gray-500">
      <%= I18n.t("dashboard.jobs.no_runs") %>
    </p>
  <% else %>
    <div class="flex flex-col gap-1 text-xs text-gray-500 dark:text-gray-400 mt-1">
      <div
        class="flex items-center gap-1"
        data-job-run-status="<%= last_job_run.status %>"
      >
        <%= lucide_icon "clock", class: "h-3 w-3 flex-shrink-0" %>

        <% if last_job_run.completed_at %>
          <span title="<%= l(last_job_run.completed_at) %>">
            <%= time_ago_in_words(last_job_run.completed_at) %> <%= I18n.t("dashboard.jobs.ago") %>
          </span>
        <% else %>
          <span>-</span>
        <% end %>
      </div>

      <div class="flex items-center gap-1">
        <%= lucide_icon "timer", class: "h-3 w-3 flex-shrink-0" %>

        <span>
          <%= last_job_run.duration ? distance_of_time_in_words(last_job_run.duration) : "-" %>
        </span>
      </div>
    </div>
  <% end %>
</div>

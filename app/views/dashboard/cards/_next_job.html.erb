<div class="card flex flex-col gap-2">
  <% next_job = next_jobs.first %>

  <h2
    class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"
    title="<%= next_job&.name %>"
  >
    <% if next_job.nil? %>
      <%= I18n.t("dashboard.jobs.next_job") %>
    <% else %>
      <%= I18n.t("dashboard.jobs.next_job") %> :
      <%= link_to next_job.name, edit_job_path(next_job), class: "hover:underline" %>
    <% end %>
  </h2>

  <% if next_jobs.empty? %>
    <p class="text-xs text-gray-400 dark:text-gray-500">
      <%= I18n.t("dashboard.jobs.no_jobs") %>
    </p>
  <% else %>
    <% next_run_at = next_job.scheduled_next_run %>
    <div class="flex flex-col gap-1 text-xs text-gray-500 dark:text-gray-400 mt-1">
      <div class="flex items-center gap-1" title="<%= l(next_run_at) %>">
        <%= lucide_icon "clock", class: "h-3 w-3 flex-shrink-0" %>
        <%= I18n.t("dashboard.jobs.runs_in", time: distance_of_time_in_words_to_now(next_run_at, include_seconds: false)) %>
      </div>
    </div>
  <% end %>
</div>

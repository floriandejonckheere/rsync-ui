<div class="card flex flex-col gap-3">
  <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">
    <%= I18n.t("dashboard.next_job.title") %>
  </h2>

  <% if next_jobs.empty? %>
    <div
      class="
        flex flex-col items-center justify-center py-6 gap-2 text-gray-400
        dark:text-gray-500
      "
    >
      <%= lucide_icon "calendar", class: "h-8 w-8" %>

      <p class="text-sm">
        <%= I18n.t("dashboard.next_job.no_jobs") %>
      </p>
    </div>
  <% else %>
    <ul class="flex flex-col gap-2">
      <% next_jobs.each do |job| %>
        <% next_run_at = job.scheduled_next_run %>

        <li class="flex items-center justify-between gap-2 text-xs">
          <span class="text-gray-900 dark:text-gray-100 truncate">
            <%= job.name %>
          </span>

          <span
            class="text-gray-400 dark:text-gray-500 flex-shrink-0"
            title="<%= l(next_run_at) %>"
          >
            <%= I18n.t("dashboard.next_job.runs_in", time: distance_of_time_in_words_to_now(next_run_at, include_seconds: false)) %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

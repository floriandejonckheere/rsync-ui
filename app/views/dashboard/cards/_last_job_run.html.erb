<div class="card flex flex-col gap-3">
  <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">
    <%= I18n.t("dashboard.last_job_run.title") %>
  </h2>

  <% if last_job_run.nil? %>
    <div
      class="
        flex flex-col items-center justify-center py-6 gap-2 text-gray-400
        dark:text-gray-500
      "
    >
      <%= lucide_icon "clock", class: "h-8 w-8" %>

      <p class="text-sm">
        <%= I18n.t("dashboard.last_job_run.no_runs") %>
      </p>
    </div>
  <% else %>
    <p class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">
      <%= last_job_run.job.name %>
    </p>
    <dl class="flex flex-col gap-1.5">
      <div class="flex justify-between text-xs">
        <dt class="text-gray-500 dark:text-gray-400">
          <%= I18n.t("dashboard.last_job_run.started_at") %>
        </dt>

        <dd class="text-gray-900 dark:text-gray-100">
          <% if last_job_run.started_at %>
            <span title="<%= l(last_job_run.started_at) %>">
              <%= time_ago_in_words(last_job_run.started_at) %> <%= I18n.t("dashboard.last_job_run.ago") %>
            </span>
          <% else %>
            -
          <% end %>
        </dd>
      </div>

      <div class="flex justify-between text-xs">
        <dt class="text-gray-500 dark:text-gray-400">
          <%= I18n.t("dashboard.last_job_run.duration") %>
        </dt>

        <dd class="text-gray-900 dark:text-gray-100">
          <%= last_job_run.duration ? distance_of_time_in_words(last_job_run.duration) : "-" %>
        </dd>
      </div>

      <% if last_job_run.bytes_copied? %>
        <div class="flex justify-between text-xs">
          <dt class="text-gray-500 dark:text-gray-400">
            <%= I18n.t("dashboard.last_job_run.bytes_copied") %>
          </dt>

          <dd class="text-gray-900 dark:text-gray-100">
            <%= last_job_run.bytes_copied.positive? ? number_to_human_size(last_job_run.bytes_copied) : "-" %>
          </dd>
        </div>
      <% end %>
    </dl>
    <div
      class="text-xs font-medium"
      data-job-run-status="<%= last_job_run.status %>"
    >
      <%= I18n.t("job_runs.status.#{last_job_run.status}") %>
    </div>
  <% end %>
</div>

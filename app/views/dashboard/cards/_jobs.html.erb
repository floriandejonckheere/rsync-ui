<div class="card flex flex-col gap-4">
  <%# Last job %>
  <div class="flex flex-col gap-1.5">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">
      <%= I18n.t("dashboard.jobs.last_job") %>
    </h2>

    <% if last_job_run.nil? %>
      <p class="text-xs text-gray-400 dark:text-gray-500">
        <%= I18n.t("dashboard.jobs.no_runs") %>
      </p>
    <% else %>
      <p class="text-xs font-medium text-gray-900 dark:text-gray-100 truncate">
        <%= last_job_run.job.name %>
      </p>
      <div class="flex flex-col gap-1 text-xs text-gray-500 dark:text-gray-400 mt-4">
        <div
          class="flex items-center gap-1"
          data-job-run-status="<%= last_job_run.status %>"
        >
          <%= lucide_icon "clock", class: "h-3 w-3 flex-shrink-0" %>

          <% if last_job_run.completed_at %>
            <span title="<%= l(last_job_run.completed_at) %>">
              <%= time_ago_in_words(last_job_run.completed_at) %> <%= I18n.t("dashboard.jobs.ago") %>
            </span>
          <% else %>
            <span>-</span>
          <% end %>
        </div>

        <div class="flex items-center gap-1">
          <%= lucide_icon "timer", class: "h-3 w-3 flex-shrink-0" %>

          <span>
            <%= last_job_run.duration ? distance_of_time_in_words(last_job_run.duration) : "-" %>
          </span>
        </div>
      </div>
    <% end %>
  </div>

  <hr class="border-gray-100 dark:border-gray-800">

  <%# Next job %>
  <div class="flex flex-col gap-1.5">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">
      <%= I18n.t("dashboard.jobs.next_job") %>
    </h2>

    <% if next_jobs.empty? %>
      <p class="text-xs text-gray-400 dark:text-gray-500">
        <%= I18n.t("dashboard.jobs.no_jobs") %>
      </p>
    <% else %>
      <ul class="flex flex-col gap-1.5">
        <% next_jobs.each do |job| %>
          <% next_run_at = job.scheduled_next_run %>

          <li class="flex items-center justify-between gap-2 text-xs">
            <span class="text-gray-900 dark:text-gray-100 truncate">
              <%= job.name %>
            </span>

            <span
              class="
                flex items-center gap-1 text-gray-400 dark:text-gray-500
                flex-shrink-0
              "
              title="<%= l(next_run_at) %>"
            >
              <%= lucide_icon "clock", class: "h-3 w-3" %>
              <%= I18n.t("dashboard.jobs.runs_in", time: distance_of_time_in_words_to_now(next_run_at, include_seconds: false)) %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

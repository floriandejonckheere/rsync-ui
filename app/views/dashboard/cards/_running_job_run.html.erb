<li
  id="<%= dom_id(job_run, :running) %>"
  class="flex flex-col gap-1"
  data-controller="job-run-status"
  data-job-run-status-job-run-id-value="<%= job_run.id %>"
>
  <div class="flex items-center justify-between gap-2 text-xs">
    <span class="font-medium text-gray-900 dark:text-gray-100 truncate">
      <%= job_run.job.name %>
    </span>

    <span
      class="flex-shrink-0"
      data-job-run-status="<%= job_run.status %>"
      data-job-run-status-target="jobStatus"
    >
      <% if job_run.running? && job_run.progress %>
        <%= I18n.t("job_runs.status.running_progress", progress: job_run.progress) %>
      <% else %>
        <%= I18n.t("job_runs.status.#{job_run.status}") %>
      <% end %>
    </span>
  </div>

  <div
    class="text-xs text-gray-500 dark:text-gray-400<%= ' hidden' unless job_run.running? && job_run.speed.present? %>"
    data-job-run-status-target="speedInfo"
  >
    <% if job_run.speed.present? %>
      <%= I18n.t("job_runs.status.running_speed", speed: format_speed(job_run.speed), remaining: format_remaining_time(job_run.remaining_time)) %>
    <% end %>
  </div>

  <div
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="<%= job_run.progress || 0 %>"
    class="relative h-1.5 w-full overflow-hidden rounded-full bg-blue-100 dark:bg-blue-950<%= ' hidden' unless job_run.running? && job_run.progress %>"
    data-job-run-status-target="progressBar"
  >
    <div
      class="h-full w-full flex-1 bg-blue-600 dark:bg-blue-400 transition-all"
      style="transform: translateX(-<%= job_run.progress ? 100 - job_run.progress.to_i : 100 %>%)"
      data-job-run-status-target="progressFill"
    ></div>
  </div>
</li>

<% content_for :title do %>
  <%= I18n.t("dashboard.title") %>
<% end %>

<% content_for :subtitle do %>
  <%= I18n.t("dashboard.subtitle") %>
<% end %>

<div class="flex flex-col gap-8">
  <%# Row 1: Status, repositories, last job run, next scheduled job %>
  <h2 class="text-lg font-semibold">
    <%= I18n.t("dashboard.repositories_and_jobs.title") %>
  </h2>

  <div class="grid grid-cols-4 gap-4 items-stretch">
    <%= render "dashboard/cards/status",
               health_status: @health_status,
               job_run_stats: @job_run_stats %>

    <%= render "dashboard/cards/repositories_storage",
               repository_counts: @repository_counts %>

    <div class="flex flex-col gap-4">
      <%= render "dashboard/cards/last_job",
                 last_job_run: @last_job_run %>

      <%= render "dashboard/cards/next_job",
                 next_jobs: @next_jobs %>
    </div>

    <%= render "dashboard/cards/running_jobs",
               running_job_runs: @running_job_runs %>
  </div>

  <%# Row 2: Server health (existing) %>
  <% if Configuration.get("resource_usage") %>
    <div class="flex flex-col gap-4">
      <h2 class="text-lg font-semibold">
        <%= I18n.t("dashboard.server_health.title") %>
      </h2>

      <% if @servers.empty? %>
        <div
          class="
            flex flex-col items-center justify-center py-12 gap-4
            text-gray-400
          "
        >
          <%= lucide_icon "server", class: "h-12 w-12" %>

          <p class="text-lg">
            <%= I18n.t("dashboard.server_health.no_servers") %>
          </p>
        </div>
      <% else %>
        <div class="flex flex-wrap gap-4">
          <% @servers.each do |server| %>
            <%= render "dashboard/server_card", server: %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag dom_id(task, :status) do %>
  <% if task.completed? %>
    <%= lucide_icon "circle-check",
                    class: "h-5 w-5 text-green-500" %>
  <% elsif task.failed? %>
    <%= lucide_icon "circle-x",
                    class: "h-5 w-5 text-red-500",
                    data: { tooltip: "#{task.error_class}: #{task.error_message}" } %>
  <% end %>
<% end %>

<%= form_with model: server, id: "server-form", class: "form", data: { controller: "unsaved-changes" } do |f| %>
  <% content_for :actions do %>
    <% if server.persisted? %>
      <%= form_with url: test_server_path(server),
                    method: :post,
                    data: {
                      turbo_stream: true,
                      controller: "server-test",
                      "server-test-source-form-value": "server-form",
                      "server-test-has-credentials-value": server.password.present? || server.ssh_key.present?,
                    } do |cf| %>
        <%= cf.hidden_field :host, data: { "server-test-target": "host" } %>
        <%= cf.hidden_field :port, data: { "server-test-target": "port" } %>
        <%= cf.hidden_field :username, data: { "server-test-target": "username" } %>
        <%= cf.hidden_field :password, data: { "server-test-target": "password" } %>
        <%= cf.hidden_field :ssh_key, data: { "server-test-target": "sshKey" } %>

        <button
          type="submit"
          class="btn-icon-outline btn-icon-lg"
          data-server-test-target="button"
          data-action="click->server-test#sync"
          data-tooltip="<%= I18n.t("servers.form.test_connection") %>"
          disabled
        >
          <%= lucide_icon "plug",
                          class: "h-6 w-6",
                          data: { "server-test-target": "icon" } %>

          <%= lucide_icon "loader-circle",
                          class: "h-6 w-6 hidden animate-spin",
                          data: { "server-test-target": "spinner" } %>
        </button>
      <% end %>
    <% end %>

    <% if server.persisted? && server.password.present? %>
      <%= form_with url: deploy_server_path(server),
                    method: :post,
                    data: {
                      turbo_stream: true,
                      controller: "server-deploy",
                      "server-deploy-source-form-value": "server-form"
                    } do |cf| %>
        <%= cf.hidden_field :host, data: { "server-deploy-target": "host" } %>
        <%= cf.hidden_field :port, data: { "server-deploy-target": "port" } %>
        <%= cf.hidden_field :username, data: { "server-deploy-target": "username" } %>

        <button
          type="submit"
          class="btn-icon-outline btn-icon-lg"
          data-server-deploy-target="button"
          data-action="click->server-deploy#sync"
          data-tooltip="<%= I18n.t("servers.form.deploy_ssh_key") %>"
        >
          <%= lucide_icon "rotate-ccw-key",
                          class: "h-6 w-6",
                          data: { "server-deploy-target": "icon" } %>

          <%= lucide_icon "loader-circle",
                          class: "h-6 w-6 hidden animate-spin",
                          data: { "server-deploy-target": "spinner" } %>
        </button>
      <% end %>
    <% end %>

    <button
      type="submit"
      form="server-form"
      class="btn-icon-outline btn-icon-lg"
      data-tooltip="<%= server.persisted? ? I18n.t("servers.form.submit_update") : I18n.t("servers.form.submit_create") %>"
    >
      <%= lucide_icon "check", class: "h-6 w-6" %>
    </button>
  <% end %>

  <% if server.errors.any? %>
    <div class="mb-8">
      <%= render "shared/forms/messages", model: server %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-8 items-start">
    <div class="flex flex-col gap-8">
      <%= render "servers/fields/details", f: f, extended: true %>
      <%= render "servers/fields/connection", f: f %>
    </div>

    <%= render "servers/fields/authentication", f: f, server: server, extended: true %>
  </div>
<% end %>

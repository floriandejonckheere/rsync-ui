<% content_for :back do %>
  <%= render "shared/menu/back", path: job_runs_path %>
<% end %>

<% content_for :title do %>
  <%= I18n.t("job_runs.show.title", sequence: @job_run.sequence) %>
<% end %>

<% content_for :subtitle do %>
  <%= I18n.t("job_runs.show.subtitle", job: @job_run.job.name) %>
<% end %>

<% if @job_run.pending? || @job_run.running? || @job_run.canceling? %>
  <div
    data-controller="job-run-status"
    data-job-run-status-job-run-id-value="<%= @job_run.id %>"
  >
    <div class="card p-0 mb-6">
      <div
        class="
          flex flex-wrap items-center justify-end gap-6 px-6 py-4
          text-sm text-gray-500 dark:text-gray-400
        "
      >
        <div
          data-job-run-status="<%= @job_run.status %>"
          data-job-run-status-target="jobStatus"
        >
          <% if @job_run.running? && @job_run.progress %>
            <%= I18n.t("job_runs.status.running_progress", progress: @job_run.progress) %>
          <% else %>
            <%= I18n.t("job_runs.status.#{@job_run.status}") %>
          <% end %>
        </div>

        <div>
          <%= I18n.t("job_runs.show.started_at") %>:
          <span data-job-run-status-target="startedAt"><%= @job_run.started_at ? relative_time_tag(@job_run.started_at) : "—" %></span>
        </div>

        <div>
          <%= I18n.t("job_runs.show.completed_at") %>:
          <span data-job-run-status-target="completedAt"><%= @job_run.completed_at ? relative_time_tag(@job_run.completed_at) : "—" %></span>
        </div>
      </div>
    </div>

    <% if @job_run.command.present? %>
      <div class="card p-0 mb-6">
        <div
          class="
            flex items-center gap-2 px-6 py-4 border-b border-gray-100
            dark:border-gray-700 text-sm text-gray-500 dark:text-gray-400
          "
        >
          <%= lucide_icon "terminal", class: "h-4 w-4" %>
          <span><%= I18n.t("job_runs.show.command") %></span>
        </div>

        <pre
          class="
            p-6 text-xs font-mono text-gray-800 dark:text-gray-200
            whitespace-pre-wrap
          "
        ><%= @job_run.command %></pre>
      </div>
    <% end %>

    <div
      class="card p-0"
      data-job-run-status-target="logCard"
      data-controller="job-run-logs"
      data-job-run-logs-job-run-id-value="<%= @job_run.id %>"
    >
      <div
        class="
          flex items-center gap-2 px-6 py-4 border-b border-gray-100
          dark:border-gray-700 text-sm text-gray-500 dark:text-gray-400
        "
      >
        <%= lucide_icon "file-text", class: "h-4 w-4" %>
        <span><%= I18n.t("job_runs.show.output_file") %></span>
      </div>

      <pre
        class="
          p-6 text-xs font-mono text-gray-800 dark:text-gray-200
          whitespace-pre-wrap max-h-[600px] overflow-y-auto
        "
        data-job-run-logs-target="log"
      ></pre>

      <% if @job_run.job.opt_progress || @job_run.job.opt_progress2 %>
        <div
          class="px-6 pb-4 text-xs font-mono text-blue-600 dark:text-blue-400"
          data-job-run-logs-target="status"
        ></div>
      <% end %>
    </div>

    <turbo-frame
      id="job-run-output"
      class="hidden"
      data-job-run-status-target="outputFrame"
    ></turbo-frame>
  </div>
<% else %>
  <div class="card p-0 mb-6">
    <div
      class="
        flex flex-wrap items-center justify-end gap-6 px-6 py-4
        text-sm text-gray-500 dark:text-gray-400
      "
    >
      <div data-job-run-status="<%= @job_run.status %>">
        <%= I18n.t("job_runs.status.#{@job_run.status}") %>
      </div>

      <div>
        <%= I18n.t("job_runs.show.started_at") %>:
        <%= @job_run.started_at ? relative_time_tag(@job_run.started_at) : "—" %>
      </div>

      <div>
        <%= I18n.t("job_runs.show.completed_at") %>:
        <%= @job_run.completed_at ? relative_time_tag(@job_run.completed_at) : "—" %>
      </div>

      <% if @job_run.exit_status&.nonzero? %>
        <div>
          <%= I18n.t("job_runs.show.exit_status") %>:
          <span class="text-red-600 dark:text-red-400"><%= @job_run.exit_status %></span>
        </div>
      <% end %>
    </div>
  </div>
  <% if @job_run.command.present? %>
    <div class="card p-0 mb-6">
      <div
        class="
          flex items-center gap-2 px-6 py-4 border-b border-gray-100
          dark:border-gray-700 text-sm text-gray-500 dark:text-gray-400
        "
      >
        <%= lucide_icon "terminal", class: "h-4 w-4" %>
        <span><%= I18n.t("job_runs.show.command") %></span>
      </div>

      <pre
        class="
          p-6 text-xs font-mono text-gray-800 dark:text-gray-200
          whitespace-pre-wrap
        "
      ><%= @job_run.command %></pre>
    </div>
  <% end %>
  <turbo-frame id="job-run-output">
    <% if @job_run.error_class.present? || @job_run.error_message.present? %>
      <div
        class="
          card p-0 mb-6 border-red-200 dark:border-red-900/50 bg-red-50/50
          dark:bg-red-950/10
        "
      >
        <div
          class="
            flex items-center justify-between px-6 py-4 border-b border-red-100
            dark:border-red-900/50
          "
        >
          <div
            class="
              flex items-center gap-2 text-red-700 dark:text-red-400
              font-medium
            "
          >
            <%= lucide_icon "alert-circle", class: "h-4 w-4" %>
            <span><%= I18n.t("job_runs.show.error_details") %></span>
          </div>

          <% unless @job_run.output.attached? %>
            <%= link_to output_job_run_path(@job_run),
                        class: "btn-icon-outline btn-icon-md",
                        data: { tooltip: I18n.t("job_runs.actions.download_logs"), turbo: false } do %>
              <%= lucide_icon "download", class: "h-4 w-4" %>
            <% end %>
          <% end %>
        </div>

        <div class="p-6">
          <% if @job_run.error_class.present? %>
            <div class="mb-4 last:mb-0">
              <div
                class="
                  text-xs font-semibold text-red-600 dark:text-red-500
                  uppercase tracking-wider
                "
              >
                <%= I18n.t("job_runs.show.error_class") %>
              </div>

              <div class="mt-1 font-mono text-sm text-gray-900 dark:text-gray-100">
                <%= @job_run.error_class %>
              </div>
            </div>
          <% end %>

          <% if @job_run.error_message.present? %>
            <div class="mb-4 last:mb-0">
              <div
                class="
                  text-xs font-semibold text-red-600 dark:text-red-500
                  uppercase tracking-wider
                "
              >
                <%= I18n.t("job_runs.show.error_message") %>
              </div>

              <div
                class="
                  mt-1 text-sm text-gray-900 dark:text-gray-100
                  whitespace-pre-wrap
                "
              >
                <%= @job_run.error_message %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @job_run.output.attached? %>
      <div class="card p-0">
        <div
          class="
            flex items-center justify-between px-6 py-4 border-b border-gray-100
            dark:border-gray-700
          "
        >
          <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
            <%= lucide_icon "file-text", class: "h-4 w-4" %>
            <span><%= I18n.t("job_runs.show.output_file") %></span>
          </div>

          <%= link_to output_job_run_path(@job_run),
                      class: "btn-icon-outline btn-icon-md",
                      data: { tooltip: I18n.t("job_runs.actions.download_logs") } do %>
            <%= lucide_icon "download", class: "h-4 w-4" %>
          <% end %>
        </div>

        <pre
          class="
            p-6 text-xs font-mono text-gray-800 dark:text-gray-200
            whitespace-pre-wrap
          "
        ><%= @job_run.output.download.gsub("\r", "") %></pre>
      </div>
    <% end %>

    <%= render "hook_output", job_run: @job_run %>
  </turbo-frame>
<% end %>

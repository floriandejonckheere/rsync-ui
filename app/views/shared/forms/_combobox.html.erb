<%# locals: (name:, value:, options:, blank_label:, placeholder:, required: false, select_data: {}, input_data: {}, input_id: nil) %>
<% select_data = local_assigns.fetch(:select_data, {}) %>
<% input_data = local_assigns.fetch(:input_data, {}) %>
<% input_id = local_assigns[:input_id] %>

<div
  class="combobox w-full"
  <% if select_data.present? %>
    <% select_data.each do |key, val| %>
      data-<%= key.to_s.dasherize %>="<%= val %>"
    <% end %>
  <% end %>
>
  <input
    type="text"
    role="combobox"
    placeholder="<%= placeholder %>"
    autocomplete="off"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls="<%= input_id || name.to_s.parameterize %>-listbox"
  >

  <%= lucide_icon "chevron-down", class: "combobox-trigger-icon" %>

  <div data-popover aria-hidden="true">
    <div
      role="listbox"
      id="<%= input_id || name.to_s.parameterize %>-listbox"
      aria-orientation="vertical"
    >
      <div role="option" data-value=""><%= blank_label %></div>

      <% options.each do |option_label, option_value, option_data| %>
        <div
          role="option"
          data-value="<%= option_value %>"
          <% option_data&.each do |key, val| %>
            data-<%= key.to_s.dasherize %>="<%= val %>"
          <% end %>
        >
          <%= option_label %>
        </div>
      <% end %>
    </div>
  </div>

  <input
    type="hidden"
    name="<%= name %>"
    value="<%= value %>"
    id="<%= input_id %>"
    <% if input_data.present? %>
      <% input_data.each do |key, val| %>
        data-<%= key.to_s.dasherize %>="<%= val %>"
      <% end %>
    <% end %>
    <%= "required" if required %>
  >
</div>

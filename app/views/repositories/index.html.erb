<% content_for :title do %>
  <%= I18n.t("repositories.index.title") %>
<% end %>

<% content_for :subtitle do %>
  <%= I18n.t("repositories.index.subtitle") %>
<% end %>

<% content_for :actions do %>
  <%= render "shared/search/search",
             url: repositories_path,
             query: @query,
             frame: "repositories_list",
             placeholder: I18n.t("repositories.index.search.placeholder") %>

  <%= link_to new_repository_path, data: { tooltip: I18n.t("repositories.index.new") }, class: "btn-icon-outline btn-icon-lg" do %>
    <%= lucide_icon "plus", class: "h-6 w-6" %>
  <% end %>
<% end %>

<%= turbo_frame_tag "repositories_list" do %>
  <% if @repositories.empty? && @query.present? %>
    <%= render "shared/search/no_results", title: I18n.t("repositories.index.search.no_results.title") %>
  <% elsif @repositories.empty? %>
    <div
      class="
        card flex flex-col items-center justify-center py-16 gap-4
        text-gray-400
      "
    >
      <%= lucide_icon "folders", class: "h-12 w-12" %>

      <p class="text-lg">
        <%= I18n.t("repositories.index.empty") %>
      </p>
    </div>
  <% else %>
    <% grouped_repositories = @repositories.group_by { |repository| repository.category.presence } %>
    <% uncategorized_repositories = grouped_repositories.delete(nil) %>

    <div class="flex flex-col gap-6">
      <% if uncategorized_repositories.present? %>
        <div>
          <% if grouped_repositories.any? %>
            <h2 class="mt-10 mb-6 text-2xl font-semibold dark:text-gray-100">
              <%= I18n.t("repositories.index.uncategorized") %>
            </h2>
          <% end %>

          <div class="card p-0">
            <%= render "table", repositories: uncategorized_repositories %>
          </div>
        </div>
      <% end %>

      <% grouped_repositories.each do |category, category_repositories| %>
        <div>
          <h2 class="mt-10 mb-6 text-2xl font-semibold dark:text-gray-100">
            <%= category %>
          </h2>

          <div class="card p-0">
            <%= render "table", repositories: category_repositories %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <%= render "shared/pagination", pagy: @pagy, path_method: :repositories_path %>
    <% end %>
  <% end %>
<% end %>
